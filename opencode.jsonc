{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.8-flash",
  "providers": {
    "llamacpp": {
      "name": "llama-server (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://host.docker.internal:8080/v1"
      },
      "models": {
        "qwen3.8-flash": {
          "modelID": "D:\\Qwen3.8-Flash-Next-Uncensored.i1-IQ4_XS.gguf",
          "name": "Qwen3.8-Flash-Next-Uncensored (i1-IQ4_XS, local)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { 
              "supported": false 
            }
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880 
    }
  }
}
